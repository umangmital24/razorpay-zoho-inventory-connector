# Zoho OAuth client (never commit real values)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Optional: for short-lived local debugging only. Refresh-token mode is preferred.
ZOHO_ACCESS_TOKEN=

# OAuth redirect URI registered in Zoho API Console
ZOHO_REDIRECT_URI=http://localhost:8080/callback

# Merchant organization. Discover it with: python examples/demo.py organizations
ZOHO_ORGANIZATION_ID=

# Data-center endpoints. Defaults below are for .com accounts.
# India: https://accounts.zoho.in and https://www.zohoapis.in
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com

# Reliability controls
ZOHO_REQUEST_TIMEOUT_SECONDS=15
ZOHO_MAX_RETRIES=4
ZOHO_MAX_SCAN_PAGES=3
ZOHO_MAX_CORRELATION_ORDERS=40
